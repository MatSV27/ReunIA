<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0">
  <diagram name="Follow-up Agent Architecture" id="followup-agent-arch">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Google Cloud boundary (container) -->
        <mxCell id="n_cloud" value="GOOGLE CLOUD — runs by itself, nothing inside needs a human to operate it" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=10;spacingLeft=14;fontSize=11;fontStyle=1;fontColor=#5C6577;fillColor=none;strokeColor=#9AA5B1;dashed=1;dashPattern=6 4;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="640" height="500" as="geometry" />
        </mxCell>

        <!-- Extraction Agent (inside cloud) -->
        <mxCell id="n_extraction" value="&lt;b&gt;Extraction Agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5C6577&quot;&gt;turns a note into tracked tasks&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7A8494&quot;&gt;Cloud Function (Gen2)&lt;br&gt;Google ADK · Gemini 3.5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;fontSize=13;fillColor=#FFFFFF;strokeColor=#D6DCE4;strokeWidth=1.5;" vertex="1" parent="n_cloud">
          <mxGeometry x="60" y="40" width="250" height="100" as="geometry" />
        </mxCell>

        <!-- Cloud Scheduler badge (inside cloud) -->
        <mxCell id="n_scheduler" value="&#9200; &lt;b&gt;Cloud Scheduler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;daily, 9am — nobody clicks anything&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;fontSize=12;fillColor=#FBEADB;strokeColor=#B9631A;fontColor=#8A4A14;" vertex="1" parent="n_cloud">
          <mxGeometry x="100" y="200" width="220" height="46" as="geometry" />
        </mxCell>

        <!-- Follow-up Agent (inside cloud) -->
        <mxCell id="n_followup" value="&lt;b&gt;Follow-up Agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5C6577&quot;&gt;decides who to nudge, how hard&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7A8494&quot;&gt;Cloud Function (Gen2)&lt;br&gt;Google ADK · Gemini 3.5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;fontSize=13;fillColor=#FFFFFF;strokeColor=#D6DCE4;strokeWidth=1.5;" vertex="1" parent="n_cloud">
          <mxGeometry x="60" y="280" width="250" height="100" as="geometry" />
        </mxCell>

        <!-- Firestore (inside cloud) - database cylinder -->
        <mxCell id="n_firestore" value="&lt;b&gt;Firestore&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;the shared memory&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;tasks — status, owner,&lt;br&gt;due date, reminders&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;tasks / events — timestamped&lt;br&gt;history, per task&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=16;align=center;verticalAlign=middle;fontSize=13;fillColor=#DEF3EE;strokeColor=#157A63;fontColor=#0F5C4C;" vertex="1" parent="n_cloud">
          <mxGeometry x="400" y="80" width="200" height="300" as="geometry" />
        </mxCell>

        <!-- You / Telegram (outside cloud) -->
        <mxCell id="n_you" value="&lt;b&gt;You&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5C6577&quot;&gt;Telegram chat with the bot&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7A8494&quot;&gt;voice note or plain text&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;fontSize=14;fillColor=#F7F9FC;strokeColor=#D6DCE4;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="190" height="130" as="geometry" />
        </mxCell>

        <!-- Dashboard (outside cloud) -->
        <mxCell id="n_dashboard" value="&lt;b&gt;Dashboard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5C6577&quot;&gt;see everything, mark done&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7A8494&quot;&gt;React · browser only, no backend&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;fontSize=14;fillColor=#F7F9FC;strokeColor=#D6DCE4;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1020" y="230" width="190" height="130" as="geometry" />
        </mxCell>

        <!-- ===== FLOW A: human-triggered (indigo) ===== -->
        <mxCell id="e1" value="1 · sends a voice note or text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#3D4FC0;fontColor=#3D4FC0;fontSize=11;fontStyle=1;exitX=1;exitY=0.25;entryX=0;entryY=0.35;labelBackgroundColor=#EFF2F6;" edge="1" parent="1" source="n_you" target="n_extraction">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="2 · extracts &amp; saves tasks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#3D4FC0;fontColor=#3D4FC0;fontSize=11;fontStyle=1;exitX=1;exitY=0.35;entryX=0;entryY=0.25;labelBackgroundColor=#EFF2F6;" edge="1" parent="1" source="n_extraction" target="n_firestore">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="3 · confirms what got saved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#3D4FC0;fontColor=#3D4FC0;fontSize=11;fontStyle=1;exitX=0;exitY=0.7;entryX=1;entryY=0.75;labelBackgroundColor=#EFF2F6;" edge="1" parent="1" source="n_extraction" target="n_you">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== trigger: scheduler wakes the agent ===== -->
        <mxCell id="e_trigger" value="wakes it up" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#B9631A;fontColor=#B9631A;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#EFF2F6;" edge="1" parent="n_cloud" source="n_scheduler" target="n_followup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== FLOW B: autonomous (amber) ===== -->
        <mxCell id="e4" value="4 · reviews every pending task" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#B9631A;fontColor=#B9631A;fontSize=11;fontStyle=1;exitX=1;exitY=0.35;entryX=0;entryY=0.75;labelBackgroundColor=#EFF2F6;" edge="1" parent="n_cloud" source="n_followup" target="n_firestore">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" value="5 · tool call: checks a task's history (only when the count alone is ambiguous)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;startArrow=classic;dashed=1;dashPattern=5 4;strokeColor=#B9631A;fontColor=#B9631A;fontSize=11;fontStyle=1;exitX=1;exitY=0.65;entryX=0;entryY=0.9;labelBackgroundColor=#EFF2F6;" edge="1" parent="n_cloud" source="n_followup" target="n_firestore">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e6" value="6 · sends one digest, only if something needs attention" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#B9631A;fontColor=#B9631A;fontSize=11;fontStyle=1;exitX=0;exitY=0.5;entryX=1;entryY=0.35;labelBackgroundColor=#EFF2F6;" edge="1" parent="1" source="n_followup" target="n_you">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== Dashboard: direct Firestore access, bypasses Cloud Functions ===== -->
        <mxCell id="e7" value="reads live · marks done — no Cloud Function in between" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;startArrow=classic;dashed=1;dashPattern=5 4;strokeColor=#157A63;fontColor=#0F5C4C;fontSize=11;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#EFF2F6;" edge="1" parent="1" source="n_firestore" target="n_dashboard">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== Legend ===== -->
        <mxCell id="legend_title" value="LEGEND" style="text;html=1;fontSize=10;fontStyle=1;fontColor=#7A8494;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="100" height="16" as="geometry" />
        </mxCell>
        <mxCell id="legend_human" value="You act — triggered by a message you send" style="text;html=1;fontSize=11.5;fontColor=#3D4FC0;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="622" width="320" height="18" as="geometry" />
        </mxCell>
        <mxCell id="legend_auto" value="It acts on its own — triggered by a clock, not a person" style="text;html=1;fontSize=11.5;fontColor=#B9631A;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="646" width="360" height="18" as="geometry" />
        </mxCell>
        <mxCell id="legend_state" value="Live view — same data both agents write, no Cloud Function needed" style="text;html=1;fontSize=11.5;fontColor=#157A63;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="670" width="420" height="18" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
